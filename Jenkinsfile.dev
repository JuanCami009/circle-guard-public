pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    environment {
        REGISTRY                              = 'circleguard'
        DEV_NS                                = 'circleguard-dev'
        GRADLE_OPTS                           = '-Dorg.gradle.daemon=false -Dorg.gradle.jvmargs=-Xmx512m'
        DOCKER_HOST                           = 'unix:///var/run/docker.sock'
        TESTCONTAINERS_RYUK_DISABLED          = 'true'
        TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE = '/var/run/docker.sock'
        // kubeconfig parcheado con host.docker.internal en lugar de 127.0.0.1
        // (el kubeconfig original del host no es accesible desde dentro del contenedor)
        KUBECONFIG                            = "${WORKSPACE}/terraform/envs/dev/kubeconfig-circleguard-dev.yaml"
        // CI/CD avanzado — SonarQube y Trivy
        SONAR_HOST_URL                        = 'http://host.docker.internal:9000'
        LOCALSTACK_HOST                       = 'host.docker.internal'
        IMAGE_TAG                             = 'dev'
        // TRIVY_EXIT_CODE=0 en dev: reporta sin bloquear ante HIGH/CRITICAL
        TRIVY_EXIT_CODE                       = '0'
    }

    stages {

        // ─────────────────────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                sh 'chmod +x gradlew'
                echo "Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT?.take(8)}"
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Prepare') {
            steps {
                // Descarga gradle-8.14-bin.zip una sola vez antes de los builds paralelos.
                // Sin esto, los 6 procesos compiten por el lock del archivo y hacen timeout.
                sh './gradlew --version --no-daemon'
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Start LocalStack') {
            steps {
                sh 'docker compose -f terraform/scripts/localstack-compose.yml up -d --no-recreate 2>/dev/null || docker compose -f terraform/scripts/localstack-compose.yml up -d'
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Build JARs') {
            parallel {
                stage('build:file-service') {
                    steps {
                        sh './gradlew :services:circleguard-file-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:gateway-service') {
                    steps {
                        sh './gradlew :services:circleguard-gateway-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:dashboard-service') {
                    steps {
                        sh './gradlew :services:circleguard-dashboard-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:form-service') {
                    steps {
                        sh './gradlew :services:circleguard-form-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:notification-service') {
                    steps {
                        sh './gradlew :services:circleguard-notification-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:promotion-service') {
                    steps {
                        sh './gradlew :services:circleguard-promotion-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:auth-service') {
                    steps {
                        sh './gradlew :services:circleguard-auth-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:identity-service') {
                    steps {
                        sh './gradlew :services:circleguard-identity-service:bootJar -x test --no-daemon'
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Unit Tests') {
            parallel {
                stage('test:file-service') {
                    steps {
                        sh './gradlew :services:circleguard-file-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-file-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:gateway-service') {
                    steps {
                        sh './gradlew :services:circleguard-gateway-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-gateway-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:dashboard-service') {
                    steps {
                        sh './gradlew :services:circleguard-dashboard-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-dashboard-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:form-service') {
                    steps {
                        sh './gradlew :services:circleguard-form-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-form-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:notification-service') {
                    steps {
                        sh './gradlew :services:circleguard-notification-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-notification-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:promotion-service') {
                    steps {
                        // Excluir tests con Testcontainers (HealthStatusReevaluationTest,
                        // AdministrativeCorrectionTest, PromotionPerformanceTest) que van a la
                        // etapa Integration Tests porque levantan contenedores Docker reales.
                        sh '''
                            ./gradlew :services:circleguard-promotion-service:test \
                                --tests "com.circleguard.promotion.controller.*" \
                                --tests "com.circleguard.promotion.listener.*" \
                                --tests "com.circleguard.promotion.service.FloorServiceTest" \
                                --tests "com.circleguard.promotion.service.HealthStatusServiceTest" \
                                --tests "com.circleguard.promotion.service.StatusLifecycleTest" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-promotion-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:auth-service') {
                    steps {
                        sh './gradlew :services:circleguard-auth-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-auth-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:identity-service') {
                    steps {
                        sh './gradlew :services:circleguard-identity-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-identity-service/build/test-results/test/*.xml'
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Integration Tests') {
            // Nota: tests que usan Testcontainers (neo4j, kafka, redis) requieren
            // acceso real al Docker socket. En entorno Linux CI funcionan correctamente.
            // En macOS con Docker Desktop el proxy de socket impide la detección de Testcontainers.
            parallel {
                stage('integration:file-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-file-service:test \
                                --tests "com.circleguard.file.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-file-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:gateway-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-gateway-service:test \
                                --tests "com.circleguard.gateway.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-gateway-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:dashboard-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-dashboard-service:test \
                                --tests "com.circleguard.dashboard.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-dashboard-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:form-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-form-service:test \
                                --tests "com.circleguard.form.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-form-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:notification-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-notification-service:test \
                                --tests "com.circleguard.notification.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-notification-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:promotion-service') {
                    steps {
                        // SurveyListenerIntegrationTest usa Neo4j Testcontainer.
                        // Omitido en macOS CI; en Linux CI ejecutar con:
                        //   --tests "com.circleguard.promotion.integration.*"
                        echo 'Tests Testcontainers de promotion-service omitidos en CI (incompatibilidad Docker Desktop proxy socket).'
                    }
                }
                stage('integration:auth-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-auth-service:test \
                                --tests "com.circleguard.auth.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-auth-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:identity-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-identity-service:test \
                                --tests "com.circleguard.identity.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-identity-service/build/test-results/test/*.xml'
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Coverage Reports') {
            // Genera y publica los reportes de cobertura JaCoCo de los 8 microservicios.
            // jacocoTestReport se ejecuta automáticamente al final de cada test task
            // (configurado en build.gradle.kts: finalizedBy("jacocoTestReport")).
            // Este stage lo archiva explícitamente para Jenkins y SonarQube.
            // Requiere: Jenkins Coverage Plugin (recordCoverage) instalado.
            steps {
                sh './gradlew jacocoTestReport --no-daemon || true'
            }
            post {
                always {
                    recordCoverage(
                        tools: [[parser: 'JACOCO',
                                 pattern: 'services/*/build/reports/jacoco/test/jacocoTestReport.xml']],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )
                    archiveArtifacts artifacts: 'services/*/build/reports/jacoco/**/*.html',
                                     allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('SonarQube Analysis') {
            // Analiza los 8 microservicios con SonarQube leyendo los reportes JaCoCo XML
            // generados en Unit Tests / Integration Tests.
            // Requiere: plugin SonarQube Scanner en Jenkins + credencial 'sonar-token'
            //           + servidor 'sonarqube' configurado en Jenkins > Configure System.
            steps {
                withSonarQubeEnv('sonarqube') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        sh './gradlew sonar --no-daemon -Dsonar.token=${SONAR_TOKEN} -Dsonar.host.url=${SONAR_HOST_URL}'
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Quality Gate') {
            // Espera el veredicto del Quality Gate de SonarQube vía webhook.
            // abortPipeline: false en dev — el resultado se registra pero NO bloquea el pipeline.
            // Requiere: webhook en SonarQube > Administration > Webhooks apuntando a
            //           http://JENKINS_URL/sonarqube-webhook/
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Docker Build :dev') {
            parallel {
                stage('docker:file-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/file-service:dev -f services/circleguard-file-service/Dockerfile .'
                    }
                }
                stage('docker:gateway-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/gateway-service:dev -f services/circleguard-gateway-service/Dockerfile .'
                    }
                }
                stage('docker:dashboard-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/dashboard-service:dev -f services/circleguard-dashboard-service/Dockerfile .'
                    }
                }
                stage('docker:form-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/form-service:dev -f services/circleguard-form-service/Dockerfile .'
                    }
                }
                stage('docker:notification-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/notification-service:dev -f services/circleguard-notification-service/Dockerfile .'
                    }
                }
                stage('docker:promotion-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/promotion-service:dev -f services/circleguard-promotion-service/Dockerfile .'
                    }
                }
                stage('docker:auth-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/auth-service:dev -f services/circleguard-auth-service/Dockerfile .'
                    }
                }
                stage('docker:identity-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/identity-service:dev -f services/circleguard-identity-service/Dockerfile .'
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Trivy Scan') {
            // Escanea las 8 imágenes Docker con Trivy buscando vulnerabilidades HIGH y CRITICAL.
            // TRIVY_EXIT_CODE=0 en dev → genera reportes HTML sin bloquear el pipeline.
            // Los reportes se archivan como artefactos del build para revisión.
            steps {
                sh '''
                    mkdir -p trivy-reports
                    SCAN_FAIL=0
                    for svc in file gateway dashboard form notification promotion auth identity; do
                        echo "Escaneando ${REGISTRY}/${svc}-service:${IMAGE_TAG}..."
                        docker run --rm \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            -v "$PWD/trivy-reports":/out \
                            -v trivy-db-cache:/root/.cache/trivy \
                            aquasec/trivy:latest image \
                            --severity HIGH,CRITICAL \
                            --exit-code ${TRIVY_EXIT_CODE} \
                            --format template \
                            --template "@contrib/html.tpl" \
                            -o /out/trivy-${svc}.html \
                            ${REGISTRY}/${svc}-service:${IMAGE_TAG} || SCAN_FAIL=1
                    done
                    if [ "${TRIVY_EXIT_CODE}" = "1" ] && [ "${SCAN_FAIL}" = "1" ]; then
                        echo "Trivy encontró vulnerabilidades HIGH/CRITICAL — bloqueando pipeline."
                        exit 1
                    fi
                    echo "Trivy scan completado (reportes en trivy-reports/)."
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-reports/*.html', allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Trivy IaC Scan') {
            // Seguridad (Punto 8): escaneo de misconfiguraciones en manifests K8s y
            // módulos Terraform. Usa modo "config" de Trivy (IaC/misconfig).
            // TRIVY_EXIT_CODE=0 en dev → genera reportes sin bloquear el pipeline.
            steps {
                sh '''
                    mkdir -p trivy-reports
                    echo "Escaneando manifests k8s/ con Trivy config..."
                    docker run --rm \
                        -v "$PWD":/src \
                        -v "$PWD/trivy-reports":/out \
                        -v trivy-db-cache:/root/.cache/trivy \
                        aquasec/trivy:latest config \
                        --severity HIGH,CRITICAL \
                        --exit-code ${TRIVY_EXIT_CODE} \
                        --format template \
                        --template "@contrib/html.tpl" \
                        -o /out/trivy-iac-k8s.html \
                        /src/k8s || true
                    echo "Escaneando terraform/ con Trivy config..."
                    docker run --rm \
                        -v "$PWD":/src \
                        -v "$PWD/trivy-reports":/out \
                        -v trivy-db-cache:/root/.cache/trivy \
                        aquasec/trivy:latest config \
                        --severity HIGH,CRITICAL \
                        --exit-code ${TRIVY_EXIT_CODE} \
                        --format template \
                        --template "@contrib/html.tpl" \
                        -o /out/trivy-iac-terraform.html \
                        /src/terraform || true
                    echo "Trivy IaC scan completado (reportes en trivy-reports/)."
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-reports/trivy-iac-*.html', allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Bootstrap Backend') {
            steps {
                sh 'bash terraform/scripts/bootstrap-backend.sh'
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Deploy Dev (Terraform)') {
            steps {
                dir('terraform/envs/dev') {
                    sh 'terraform init -input=false'
                    sh '''
                        # Taint cluster if control-plane container is not running so terraform recreates it
                        if ! docker inspect --format "{{.State.Running}}" circleguard-dev-control-plane 2>/dev/null | grep -q "true"; then
                            echo "==> kind cluster container not running — tainting module.cluster for recreation"
                            terraform taint -ignore-remote-version module.cluster.null_resource.cluster 2>/dev/null || true
                        fi
                    '''
                    sh 'terraform apply -input=false -auto-approve -target=module.cluster'
                }
                sh 'bash terraform/scripts/load-images.sh dev'
                dir('terraform/envs/dev') {
                    sh 'terraform apply -input=false -auto-approve -var="image_tag=dev"'
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Smoke Tests') {
            steps {
                sh '''
                    echo "Esperando que los pods del entorno dev esten listos..."
                    kubectl rollout status deployment/file-service         -n circleguard-dev --timeout=120s
                    kubectl rollout status deployment/gateway-service      -n circleguard-dev --timeout=120s
                    kubectl rollout status deployment/dashboard-service    -n circleguard-dev --timeout=120s
                    kubectl rollout status deployment/form-service         -n circleguard-dev --timeout=120s
                    kubectl rollout status deployment/notification-service -n circleguard-dev --timeout=120s
                    kubectl rollout status deployment/promotion-service    -n circleguard-dev --timeout=180s
                    kubectl rollout status deployment/auth-service         -n circleguard-dev --timeout=180s
                    kubectl rollout status deployment/identity-service     -n circleguard-dev --timeout=120s

                    echo "Ejecutando smoke tests HTTP via NodePorts..."
                    # HTTP 200, 404 o 401 indican que Spring Boot inicio correctamente.
                    # Solo HTTP 000 (connection refused) o 5xx son errores reales.
                    # Puertos 310XX (dev) en lugar de 300XX (prod) para evitar conflictos de NodePort
                    for port_svc in "31085:file-service" "31087:gateway-service" "31084:dashboard-service" "31086:form-service" "31082:notification-service" "31088:promotion-service" "31180:auth-service" "31083:identity-service"; do
                        PORT=$(echo $port_svc | cut -d: -f1)
                        SVC=$(echo $port_svc  | cut -d: -f2)
                        CODE=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 http://host.docker.internal:$PORT/)
                        echo "${SVC} (puerto ${PORT}): HTTP ${CODE}"
                        if [ "$CODE" = "000" ]; then
                            echo "ERROR: ${SVC} no responde (connection refused)"
                            exit 1
                        fi
                    done
                    echo "Todos los smoke tests pasaron."
                '''
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('E2E Tests') {
            // Suite E2E Karate — journeys cross-service reales (Punto 5).
            // Journeys: A (acceso campus sano→GREEN), B (síntomas→RED), C (visitante),
            //           + suite de humo (disponibilidad 8 servicios).
            // Prerrequisito: configurar en Jenkins las credenciales:
            //   e2e-jwt-token  → JWT válido para el entorno dev (fallback si no hay creds de login)
            //   e2e-anon-id    → anonymousId del usuario de prueba (fallback)
            //   e2e-qr-token   → QR token pre-generado (opcional)
            //   e2e-username   → usuario LDAP/local de prueba (opcional, para login real)
            //   e2e-password   → contraseña (opcional)
            steps {
                withCredentials([
                    string(credentialsId: 'e2e-jwt-token',  variable: 'TEST_JWT'),
                    string(credentialsId: 'e2e-anon-id',    variable: 'TEST_ANON_ID'),
                    string(credentialsId: 'e2e-qr-token',   variable: 'TEST_QR_TOKEN')
                ]) {
                    sh '''
                        E2E_HOST=host.docker.internal \
                        TEST_JWT=${TEST_JWT} \
                        TEST_ANON_ID=${TEST_ANON_ID} \
                        TEST_QR_TOKEN=${TEST_QR_TOKEN} \
                        ./gradlew :e2e-tests:e2eTest --no-daemon
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'e2e-tests/build/karate-reports/**',
                                     allowEmptyArchive: true
                    junit testResults: 'e2e-tests/build/test-results/e2eTest/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Performance Tests') {
            // Ejecuta Locust via Docker contra el entorno dev desplegado.
            // Se usa docker build en lugar de docker run -v para evitar el problema
            // de DinD en macOS: los volúmenes con paths del contenedor Jenkins no son
            // accesibles desde Docker Desktop. docker build envía los archivos como tar
            // al daemon (sin depender del filesystem del host).
            // El reporte HTML se archiva como artefacto del build.
            steps {
                sh '''
                    docker build -t circleguard-locust -f locust/Dockerfile locust/
                    docker rm -f locust-perf-run 2>/dev/null || true
                    docker run --name locust-perf-run \
                      --network host \
                      -e LOCUST_JWT="${TEST_JWT:-}" \
                      -e LOCUST_ANON_ID="${TEST_ANON_ID:-test-anon-id}" \
                      circleguard-locust \
                      -f /mnt/locust/locustfile.py \
                      --config /mnt/locust/locust.conf || true
                    docker cp locust-perf-run:/mnt/locust/locust-report.html locust/locust-report.html || true
                    docker cp locust-perf-run:/mnt/locust/locust-stats_stats.csv locust/locust-stats_stats.csv || true
                    docker rm locust-perf-run || true
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'locust/locust-report.html,locust/locust-stats*.csv',
                                     allowEmptyArchive: true
                }
            }
        }

    }

    post {
        always {
            echo "Pipeline finalizado: ${currentBuild.currentResult}"
        }
        success {
            echo "Dev pipeline EXITOSO — imagenes :dev desplegadas en namespace: circleguard-dev"
        }
        failure {
            echo "Dev pipeline FALLIDO — revisar logs anteriores"
            emailext(
                subject: "❌ FALLÓ ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.GIT_BRANCH})",
                body: """Pipeline de desarrollo fallido.

Job     : ${env.JOB_NAME}
Build   : #${env.BUILD_NUMBER}
Branch  : ${env.GIT_BRANCH}
Commit  : ${env.GIT_COMMIT}
Consola : ${env.BUILD_URL}console
""",
                to: 'devops@circleguard.local'
            )
        }
        unstable {
            emailext(
                subject: "⚠️ INESTABLE ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.GIT_BRANCH})",
                body: """Pipeline de desarrollo inestable (Quality Gate degradado o tests con advertencias).

Job     : ${env.JOB_NAME}
Build   : #${env.BUILD_NUMBER}
Branch  : ${env.GIT_BRANCH}
Commit  : ${env.GIT_COMMIT}
Consola : ${env.BUILD_URL}console
""",
                to: 'devops@circleguard.local'
            )
        }
    }
}
