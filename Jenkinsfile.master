pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    environment {
        REGISTRY                              = 'circleguard'
        PROD_NS                               = 'circleguard'
        GRADLE_OPTS                           = '-Dorg.gradle.daemon=false -Dorg.gradle.jvmargs=-Xmx512m'
        DOCKER_HOST                           = 'unix:///var/run/docker.sock'
        TESTCONTAINERS_RYUK_DISABLED          = 'true'
        TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE = '/var/run/docker.sock'
        // kubeconfig parcheado con host.docker.internal en lugar de 127.0.0.1
        // (el kubeconfig original del host no es accesible desde dentro del contenedor)
        KUBECONFIG                            = "${WORKSPACE}/terraform/envs/prod/kubeconfig-circleguard-prod.yaml"
        // CI/CD avanzado — SonarQube y Trivy
        SONAR_HOST_URL                        = 'http://host.docker.internal:9000'
        LOCALSTACK_HOST                       = 'host.docker.internal'
        TF_VAR_localstack_host                = 'host.docker.internal'
        IMAGE_TAG                             = 'latest'
        // TRIVY_EXIT_CODE=1 en prod: BLOQUEA el pipeline si encuentra HIGH/CRITICAL
        TRIVY_EXIT_CODE                       = '1'
    }

    stages {

        // ─────────────────────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                sh 'chmod +x gradlew'
                echo "Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT?.take(8)}"
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Prepare') {
            steps {
                // Descarga gradle-8.14-bin.zip una sola vez antes de los builds paralelos.
                // Sin esto, los 6 procesos compiten por el lock del archivo y hacen timeout.
                sh './gradlew --version --no-daemon'
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Start LocalStack') {
            steps {
                sh 'docker compose -f terraform/scripts/localstack-compose.yml up -d --no-recreate 2>/dev/null || docker compose -f terraform/scripts/localstack-compose.yml up -d'
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Build JARs') {
            parallel {
                stage('build:file-service') {
                    steps {
                        sh './gradlew :services:circleguard-file-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:gateway-service') {
                    steps {
                        sh './gradlew :services:circleguard-gateway-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:dashboard-service') {
                    steps {
                        sh './gradlew :services:circleguard-dashboard-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:form-service') {
                    steps {
                        sh './gradlew :services:circleguard-form-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:notification-service') {
                    steps {
                        sh './gradlew :services:circleguard-notification-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:promotion-service') {
                    steps {
                        sh './gradlew :services:circleguard-promotion-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:auth-service') {
                    steps {
                        sh './gradlew :services:circleguard-auth-service:bootJar -x test --no-daemon'
                    }
                }
                stage('build:identity-service') {
                    steps {
                        sh './gradlew :services:circleguard-identity-service:bootJar -x test --no-daemon'
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Unit Tests') {
            parallel {
                stage('test:file-service') {
                    steps {
                        sh './gradlew :services:circleguard-file-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-file-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:gateway-service') {
                    steps {
                        sh './gradlew :services:circleguard-gateway-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-gateway-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:dashboard-service') {
                    steps {
                        sh './gradlew :services:circleguard-dashboard-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-dashboard-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:form-service') {
                    steps {
                        sh './gradlew :services:circleguard-form-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-form-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:notification-service') {
                    steps {
                        sh './gradlew :services:circleguard-notification-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-notification-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:promotion-service') {
                    steps {
                        // Excluir tests con Testcontainers (HealthStatusReevaluationTest,
                        // AdministrativeCorrectionTest, PromotionPerformanceTest) que van a la
                        // etapa Integration Tests porque levantan contenedores Docker reales.
                        sh '''
                            ./gradlew :services:circleguard-promotion-service:test \
                                --tests "com.circleguard.promotion.controller.*" \
                                --tests "com.circleguard.promotion.listener.*" \
                                --tests "com.circleguard.promotion.service.FloorServiceTest" \
                                --tests "com.circleguard.promotion.service.HealthStatusServiceTest" \
                                --tests "com.circleguard.promotion.service.StatusLifecycleTest" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-promotion-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:auth-service') {
                    steps {
                        sh './gradlew :services:circleguard-auth-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-auth-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('test:identity-service') {
                    steps {
                        sh './gradlew :services:circleguard-identity-service:test --no-daemon'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-identity-service/build/test-results/test/*.xml'
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Integration Tests') {
            // Nota: tests que usan Testcontainers (neo4j, kafka, redis) requieren
            // acceso real al Docker socket. En entorno Linux CI funcionan correctamente.
            // En macOS con Docker Desktop el proxy de socket impide la detección de Testcontainers.
            parallel {
                stage('integration:file-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-file-service:test \
                                --tests "com.circleguard.file.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-file-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:gateway-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-gateway-service:test \
                                --tests "com.circleguard.gateway.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-gateway-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:dashboard-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-dashboard-service:test \
                                --tests "com.circleguard.dashboard.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-dashboard-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:form-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-form-service:test \
                                --tests "com.circleguard.form.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-form-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:notification-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-notification-service:test \
                                --tests "com.circleguard.notification.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-notification-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:promotion-service') {
                    steps {
                        // SurveyListenerIntegrationTest usa Neo4j Testcontainer.
                        // Omitido en macOS CI; en Linux CI ejecutar con:
                        //   --tests "com.circleguard.promotion.integration.*"
                        echo 'Tests Testcontainers de promotion-service omitidos en CI (incompatibilidad Docker Desktop proxy socket).'
                    }
                }
                stage('integration:auth-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-auth-service:test \
                                --tests "com.circleguard.auth.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-auth-service/build/test-results/test/*.xml'
                        }
                    }
                }
                stage('integration:identity-service') {
                    steps {
                        sh '''
                            ./gradlew :services:circleguard-identity-service:test \
                                --tests "com.circleguard.identity.integration.*" \
                                --no-daemon
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'services/circleguard-identity-service/build/test-results/test/*.xml'
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Coverage Reports') {
            // Genera y publica reportes JaCoCo de los 8 microservicios.
            // Requiere Jenkins Coverage Plugin instalado.
            steps {
                sh './gradlew jacocoTestReport --no-daemon || true'
            }
            post {
                always {
                    recordCoverage(
                        tools: [[parser: 'JACOCO',
                                 pattern: 'services/*/build/reports/jacoco/test/jacocoTestReport.xml']],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )
                    archiveArtifacts artifacts: 'services/*/build/reports/jacoco/**/*.html',
                                     allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('SonarQube Analysis') {
            // Analiza los 8 microservicios con SonarQube leyendo los reportes JaCoCo XML
            // generados en Unit Tests / Integration Tests.
            // Requiere: plugin SonarQube Scanner en Jenkins + credencial 'sonar-token'
            //           + servidor 'sonarqube' configurado en Jenkins > Configure System.
            steps {
                withSonarQubeEnv('sonarqube') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        sh './gradlew sonar --no-daemon -Dsonar.token=${SONAR_TOKEN} -Dsonar.host.url=${SONAR_HOST_URL}'
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Quality Gate') {
            // Espera el veredicto del Quality Gate de SonarQube vía webhook.
            // abortPipeline: true en prod — BLOQUEA el release si el Quality Gate falla.
            // Ningún código con deuda técnica crítica o cobertura insuficiente llega a producción.
            // Requiere: webhook en SonarQube > Administration > Webhooks apuntando a
            //           http://JENKINS_URL/sonarqube-webhook/
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Docker Build :latest') {
            parallel {
                stage('docker:file-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/file-service:latest -f services/circleguard-file-service/Dockerfile .'
                    }
                }
                stage('docker:gateway-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/gateway-service:latest -f services/circleguard-gateway-service/Dockerfile .'
                    }
                }
                stage('docker:dashboard-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/dashboard-service:latest -f services/circleguard-dashboard-service/Dockerfile .'
                    }
                }
                stage('docker:form-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/form-service:latest -f services/circleguard-form-service/Dockerfile .'
                    }
                }
                stage('docker:notification-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/notification-service:latest -f services/circleguard-notification-service/Dockerfile .'
                    }
                }
                stage('docker:promotion-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/promotion-service:latest -f services/circleguard-promotion-service/Dockerfile .'
                    }
                }
                stage('docker:auth-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/auth-service:latest -f services/circleguard-auth-service/Dockerfile .'
                    }
                }
                stage('docker:identity-service') {
                    steps {
                        sh 'docker build -t ${REGISTRY}/identity-service:latest -f services/circleguard-identity-service/Dockerfile .'
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Trivy Scan') {
            // Escanea las 8 imágenes Docker con Trivy buscando vulnerabilidades HIGH y CRITICAL.
            // TRIVY_EXIT_CODE=1 en prod → BLOQUEA el pipeline si alguna imagen tiene HIGH/CRITICAL.
            // Para aceptar un CVE conscientemente, agregar el CVE a .trivyignore con justificación.
            steps {
                sh '''
                    mkdir -p trivy-reports
                    SCAN_FAIL=0
                    for svc in file gateway dashboard form notification promotion auth identity; do
                        echo "Escaneando ${REGISTRY}/${svc}-service:${IMAGE_TAG}..."
                        docker run --rm \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            -v "$PWD/trivy-reports":/out \
                            -v "$PWD/.trivyignore":/.trivyignore \
                            -v trivy-db-cache:/root/.cache/trivy \
                            aquasec/trivy:latest image \
                            --severity HIGH,CRITICAL \
                            --exit-code ${TRIVY_EXIT_CODE} \
                            --ignorefile /.trivyignore \
                            --format template \
                            --template "@contrib/html.tpl" \
                            -o /out/trivy-${svc}.html \
                            ${REGISTRY}/${svc}-service:${IMAGE_TAG} || SCAN_FAIL=1
                    done
                    if [ "${TRIVY_EXIT_CODE}" = "1" ] && [ "${SCAN_FAIL}" = "1" ]; then
                        echo "Trivy encontró vulnerabilidades HIGH/CRITICAL — bloqueando release a producción."
                        echo "Opciones: (1) parchear la imagen base, (2) agregar CVE a .trivyignore con justificación."
                        exit 1
                    fi
                    echo "Trivy scan completado — sin vulnerabilidades HIGH/CRITICAL bloqueantes."
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-reports/*.html', allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Trivy IaC Scan') {
            // Seguridad (Punto 8): escaneo de misconfiguraciones en manifests K8s y
            // módulos Terraform. TRIVY_EXIT_CODE=1 en prod → bloquea si hay HIGH/CRITICAL.
            steps {
                sh '''
                    mkdir -p trivy-reports
                    IAC_FAIL=0
                    echo "Escaneando manifests k8s/ con Trivy config..."
                    docker run --rm \
                        -v "$PWD":/src \
                        -v "$PWD/trivy-reports":/out \
                        -v trivy-db-cache:/root/.cache/trivy \
                        aquasec/trivy:latest config \
                        --severity HIGH,CRITICAL \
                        --exit-code ${TRIVY_EXIT_CODE} \
                        --format template \
                        --template "@contrib/html.tpl" \
                        -o /out/trivy-iac-k8s.html \
                        /src/k8s || IAC_FAIL=1
                    echo "Escaneando terraform/ con Trivy config..."
                    docker run --rm \
                        -v "$PWD":/src \
                        -v "$PWD/trivy-reports":/out \
                        -v trivy-db-cache:/root/.cache/trivy \
                        aquasec/trivy:latest config \
                        --severity HIGH,CRITICAL \
                        --exit-code ${TRIVY_EXIT_CODE} \
                        --format template \
                        --template "@contrib/html.tpl" \
                        -o /out/trivy-iac-terraform.html \
                        /src/terraform || IAC_FAIL=1
                    if [ "${TRIVY_EXIT_CODE}" = "1" ] && [ "${IAC_FAIL}" = "1" ]; then
                        echo "Trivy IaC encontró misconfiguraciones HIGH/CRITICAL — bloqueando release a producción."
                        exit 1
                    fi
                    echo "Trivy IaC scan completado — sin misconfiguraciones HIGH/CRITICAL bloqueantes."
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-reports/trivy-iac-*.html', allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Bootstrap Backend') {
            steps {
                sh 'bash terraform/scripts/bootstrap-backend.sh'
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Approval (Prod)') {
            steps {
                input message: 'Desplegar a produccion?', ok: 'Desplegar'
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Deploy Master (Terraform)') {
            steps {
                dir('terraform/envs/prod') {
                    sh 'terraform init -input=false'
                    sh 'terraform apply -input=false -auto-approve -target=module.cluster'
                }
                sh 'bash terraform/scripts/load-images.sh prod'
                dir('terraform/envs/prod') {
                    sh 'terraform apply -input=false -auto-approve -var="image_tag=latest"'
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Smoke Tests') {
            steps {
                sh '''
                    echo "Esperando que los pods del entorno master esten listos..."
                    kubectl rollout status deployment/file-service         -n circleguard --timeout=120s
                    kubectl rollout status deployment/gateway-service      -n circleguard --timeout=120s
                    kubectl rollout status deployment/dashboard-service    -n circleguard --timeout=120s
                    kubectl rollout status deployment/form-service         -n circleguard --timeout=120s
                    kubectl rollout status deployment/notification-service -n circleguard --timeout=120s
                    kubectl rollout status deployment/promotion-service    -n circleguard --timeout=180s
                    kubectl rollout status deployment/auth-service         -n circleguard --timeout=180s
                    kubectl rollout status deployment/identity-service     -n circleguard --timeout=120s

                    echo "Ejecutando smoke tests HTTP via NodePorts..."
                    # HTTP 200, 404 o 401 indican que Spring Boot inicio correctamente.
                    # Solo HTTP 000 (connection refused) o 5xx son errores reales.
                    # Puertos 300XX (producción) — el esquema canónico de los manifests
                    for port_svc in "30085:file-service" "30087:gateway-service" "30084:dashboard-service" "30086:form-service" "30082:notification-service" "30088:promotion-service" "30180:auth-service" "30083:identity-service"; do
                        PORT=$(echo $port_svc | cut -d: -f1)
                        SVC=$(echo $port_svc  | cut -d: -f2)
                        CODE=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 http://host.docker.internal:$PORT/)
                        echo "${SVC} (puerto ${PORT}): HTTP ${CODE}"
                        if [ "$CODE" = "000" ]; then
                            echo "ERROR: ${SVC} no responde (connection refused)"
                            exit 1
                        fi
                    done
                    echo "Todos los smoke tests pasaron."
                '''
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('E2E Tests') {
            // Suite E2E Karate — journeys cross-service reales contra namespace prod (300XX).
            // Journeys: A (acceso campus sano→GREEN), B (síntomas→RED), C (visitante),
            //           + suite de humo (disponibilidad 8 servicios).
            // Reutiliza las credenciales Jenkins ya configuradas para dev y stage.
            steps {
                withCredentials([
                    string(credentialsId: 'e2e-jwt-token',  variable: 'TEST_JWT'),
                    string(credentialsId: 'e2e-anon-id',    variable: 'TEST_ANON_ID'),
                    string(credentialsId: 'e2e-qr-token',   variable: 'TEST_QR_TOKEN')
                ]) {
                    sh '''
                        E2E_HOST=host.docker.internal \
                        E2E_PORT_NOTIFICATION=30082 \
                        E2E_PORT_IDENTITY=30083 \
                        E2E_PORT_DASHBOARD=30084 \
                        E2E_PORT_FILE=30085 \
                        E2E_PORT_FORM=30086 \
                        E2E_PORT_GATEWAY=30087 \
                        E2E_PORT_PROMOTION=30088 \
                        E2E_PORT_AUTH=30180 \
                        TEST_JWT=${TEST_JWT} \
                        TEST_ANON_ID=${TEST_ANON_ID} \
                        TEST_QR_TOKEN=${TEST_QR_TOKEN} \
                        ./gradlew :e2e-tests:e2eTest --no-daemon
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'e2e-tests/build/karate-reports/**',
                                     allowEmptyArchive: true
                    junit testResults: 'e2e-tests/build/test-results/e2eTest/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Performance Tests') {
            // Ejecuta Locust via Docker contra el entorno master desplegado.
            // LOCUST_HOST_* redirigen cada perfil de usuario al NodePort 300XX correspondiente.
            // Se usa docker build (no -v) para evitar el problema de DinD en macOS.
            // El reporte se archiva como locust-report-master.html para distinguirlo de dev y stage.
            steps {
                sh '''
                    docker build -t circleguard-locust-master -f locust/Dockerfile locust/
                    docker rm -f locust-perf-run-master 2>/dev/null || true
                    docker run --name locust-perf-run-master \
                      --network host \
                      -e LOCUST_JWT="${TEST_JWT:-}" \
                      -e LOCUST_ANON_ID="${TEST_ANON_ID:-test-anon-id}" \
                      -e LOCUST_HOST_PROMOTION="http://host.docker.internal:30088" \
                      -e LOCUST_HOST_FORM="http://host.docker.internal:30086" \
                      -e LOCUST_HOST_GATEWAY="http://host.docker.internal:30087" \
                      -e LOCUST_HOST_DASHBOARD="http://host.docker.internal:30084" \
                      circleguard-locust-master \
                      -f /mnt/locust/locustfile.py \
                      --config /mnt/locust/locust.conf || true
                    docker cp locust-perf-run-master:/mnt/locust/locust-report.html locust/locust-report-master.html || true
                    docker cp locust-perf-run-master:/mnt/locust/locust-stats_stats.csv locust/locust-stats-master_stats.csv || true
                    docker rm locust-perf-run-master || true
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'locust/locust-report-master.html,locust/locust-stats-master*.csv',
                                     allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Security Tests (OWASP ZAP)') {
            // Escaneo pasivo de seguridad con OWASP ZAP contra los 8 servicios desplegados.
            // Modo baseline (passive): no lanza ataques activos — solo analiza tráfico pasivo.
            // ZAP_FAIL_ON=High: bloquea el release solo si hay alertas de severidad High.
            // Para suprimir falsos positivos de API, editar zap/rules.tsv con justificación.
            // Los reportes HTML se archivan como artefactos para auditoría.
            steps {
                sh 'chmod +x zap/run_zap.sh'
                sh '''
                    ZAP_HOST=host.docker.internal \
                    ZAP_FAIL_ON=High \
                    ZAP_TIMEOUT=120 \
                    E2E_HOST=host.docker.internal \
                    bash zap/run_zap.sh
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'zap/reports/*.html,zap/reports/*.json',
                                     allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('Release Notes') {
            // Genera un artefacto Markdown con las Release Notes de esta versión.
            // Clasifica commits por tipo (Conventional Commits: feat, fix, docs, otros).
            // Crea un tag Git ligero en el commit actual para marcar el release.
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-credentials',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                sh '''
                    # Versionado semántico automático: lee commits desde el último tag vX.Y.Z
                    # y calcula MAJOR/MINOR/PATCH según Conventional Commits (feat/fix/BREAKING).
                    chmod +x scripts/semver.sh
                    VERSION=$(bash scripts/semver.sh)
                    echo "Generando Release Notes para ${VERSION} (semver desde Conventional Commits)..."

                    # Determinar el rango de commits desde el tag anterior
                    PREV_TAG=$(git describe --tags --abbrev=0 HEAD^ 2>/dev/null || echo "")
                    if [ -n "$PREV_TAG" ]; then
                        RANGE="${PREV_TAG}..HEAD"
                        SINCE_MSG="Cambios desde ${PREV_TAG}"
                        echo "Rango: ${PREV_TAG} -> HEAD"
                    else
                        RANGE="HEAD~10..HEAD"
                        SINCE_MSG="Ultimos 10 commits (primer release)"
                        echo "Sin tag previo - usando los ultimos 10 commits"
                    fi

                    # Extraer commits por categoria (Conventional Commits)
                    FEAT_COMMITS=$(git log ${RANGE} --pretty=format:"- %s (%h)" --no-merges | grep "^- feat" || true)
                    FIX_COMMITS=$(git log ${RANGE} --pretty=format:"- %s (%h)" --no-merges | grep "^- fix" || true)
                    DOCS_COMMITS=$(git log ${RANGE} --pretty=format:"- %s (%h)" --no-merges | grep "^- docs" || true)
                    OTHER_COMMITS=$(git log ${RANGE} --pretty=format:"- %s (%h)" --no-merges | grep -v "^- feat\\|^- fix\\|^- docs" || true)

                    BUILD_DATE=$(date "+%Y-%m-%d %H:%M:%S UTC")
                    COMMIT_HASH=$(git rev-parse --short HEAD)
                    COMMIT_AUTHOR=$(git log -1 --pretty=format:"%an")
                    TOTAL_COMMITS=$(git log ${RANGE} --oneline --no-merges | wc -l | tr -d " ")
                    # BT genera el backtick sin escapar para evitar error del parser Groovy
                    BT=$(printf '`')

                    # Generar el archivo Markdown de Release Notes
                    {
                        echo "# Release Notes - CircleGuard ${VERSION}"
                        echo ""
                        echo "| Campo | Valor |"
                        echo "|---|---|"
                        echo "| Version | ${VERSION} |"
                        echo "| Fecha | ${BUILD_DATE} |"
                        echo "| Commit | ${BT}${COMMIT_HASH}${BT} |"
                        echo "| Autor | ${COMMIT_AUTHOR} |"
                        echo "| Build Jenkins | #${BUILD_NUMBER} |"
                        echo "| Branch | ${GIT_BRANCH} |"
                        echo "| Namespace Kubernetes | ${BT}circleguard${BT} (produccion) |"
                        echo "| Total cambios | ${TOTAL_COMMITS} commits (${SINCE_MSG}) |"
                        echo ""
                        echo "---"
                        echo ""
                        echo "## Novedades"
                        echo ""
                        if [ -n "$FEAT_COMMITS" ]; then
                            echo "$FEAT_COMMITS"
                        else
                            echo "_Sin nuevas funcionalidades en este release._"
                        fi
                        echo ""
                        echo "## Correcciones"
                        echo ""
                        if [ -n "$FIX_COMMITS" ]; then
                            echo "$FIX_COMMITS"
                        else
                            echo "_Sin correcciones de bugs en este release._"
                        fi
                        echo ""
                        echo "## Documentacion"
                        echo ""
                        if [ -n "$DOCS_COMMITS" ]; then
                            echo "$DOCS_COMMITS"
                        else
                            echo "_Sin cambios de documentacion en este release._"
                        fi
                        echo ""
                        echo "## Otros cambios"
                        echo ""
                        if [ -n "$OTHER_COMMITS" ]; then
                            echo "$OTHER_COMMITS"
                        else
                            echo "_Sin otros cambios en este release._"
                        fi
                        echo ""
                        echo "---"
                        echo ""
                        echo "## Entorno de despliegue"
                        echo ""
                        echo "| Atributo | Valor |"
                        echo "|---|---|"
                        echo "| Namespace Kubernetes | ${BT}circleguard${BT} (produccion) |"
                        echo "| Tag de imagen Docker | ${BT}:latest${BT} |"
                        echo "| NodePorts | 30082, 30083, 30084, 30085, 30086, 30087, 30088, 30180 |"
                        echo "| Pipeline | ${BT}Jenkinsfile.master${BT} |"
                        echo ""
                        echo "## Servicios desplegados"
                        echo ""
                        echo "| Servicio | Imagen | NodePort |"
                        echo "|---|---|---|"
                        echo "| notification-service | ${BT}circleguard/notification-service:latest${BT} | 30082 |"
                        echo "| dashboard-service | ${BT}circleguard/dashboard-service:latest${BT} | 30084 |"
                        echo "| file-service | ${BT}circleguard/file-service:latest${BT} | 30085 |"
                        echo "| form-service | ${BT}circleguard/form-service:latest${BT} | 30086 |"
                        echo "| gateway-service | ${BT}circleguard/gateway-service:latest${BT} | 30087 |"
                        echo "| promotion-service | ${BT}circleguard/promotion-service:latest${BT} | 30088 |"
                        echo "| auth-service | ${BT}circleguard/auth-service:latest${BT} | 30180 |"
                        echo "| identity-service | ${BT}circleguard/identity-service:latest${BT} | 30083 |"
                        echo ""
                        echo "## Validaciones ejecutadas"
                        echo ""
                        echo "- [x] Build JARs (8 servicios)"
                        echo "- [x] Unit Tests (8 servicios)"
                        echo "- [x] Integration Tests (8 servicios)"
                        echo "- [x] Coverage Reports (JaCoCo + jest)"
                        echo "- [x] Docker Build :latest (8 servicios)"
                        echo "- [x] Trivy Scan (vulnerabilidades HIGH/CRITICAL)"
                        echo "- [x] Deploy Kubernetes namespace circleguard"
                        echo "- [x] Smoke Tests (8 servicios, NodePorts 300XX)"
                        echo "- [x] E2E Tests (Karate journeys cross-service)"
                        echo "- [x] Performance Tests (Locust, 50 usuarios, 60s)"
                        echo "- [x] Security Tests (OWASP ZAP baseline, 8 servicios)"
                        echo ""
                        echo "---"
                        echo ""
                        echo "_Generado automaticamente por Jenkins - build #${BUILD_NUMBER}_"
                    } > release-notes-${VERSION}.md

                    echo "Release Notes generadas: release-notes-${VERSION}.md"
                    cat release-notes-${VERSION}.md

                    # Crear y pushear tag Git para marcar el release en el historial
                    git config user.email "jenkins@circleguard.edu"
                    git config user.name "Jenkins CI"
                    git tag ${VERSION} || true
                    echo "Tag Git creado: ${VERSION}"
                    REMOTE_URL=$(git remote get-url origin | sed "s|https://|https://${GIT_USER}:${GIT_TOKEN}@|")
                    git push "${REMOTE_URL}" ${VERSION} || true
                    echo "Tag Git pusheado al remoto: ${VERSION}"
                '''
                } // withCredentials
                archiveArtifacts artifacts: 'release-notes-*.md', allowEmptyArchive: false
            }
        }

    }

    post {
        always {
            echo "Pipeline finalizado: ${currentBuild.currentResult}"
        }
        success {
            echo "Master pipeline EXITOSO — imagenes :latest desplegadas en namespace: circleguard | Release Notes archivadas"
        }
        failure {
            echo "Master pipeline FALLIDO — revisar logs anteriores"
            emailext(
                subject: "🚨 FALLÓ PRODUCCIÓN ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.GIT_BRANCH})",
                body: """ALERTA: Pipeline de producción fallido.

Job     : ${env.JOB_NAME}
Build   : #${env.BUILD_NUMBER}
Branch  : ${env.GIT_BRANCH}
Commit  : ${env.GIT_COMMIT}
Consola : ${env.BUILD_URL}console

Verificar: Quality Gate, Trivy Scan, o etapa de despliegue.
""",
                to: 'devops@circleguard.local'
            )
        }
        unstable {
            emailext(
                subject: "⚠️ INESTABLE PRODUCCIÓN ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.GIT_BRANCH})",
                body: """Pipeline de producción inestable (Quality Gate degradado o Trivy con advertencias).

Job     : ${env.JOB_NAME}
Build   : #${env.BUILD_NUMBER}
Branch  : ${env.GIT_BRANCH}
Commit  : ${env.GIT_COMMIT}
Consola : ${env.BUILD_URL}console
""",
                to: 'devops@circleguard.local'
            )
        }
    }
}
