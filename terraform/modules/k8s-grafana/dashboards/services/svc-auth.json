{
  "uid": "circleguard-svc-auth",
  "title": "CircleGuard — Autenticación (auth-service)",
  "description": "Métricas HTTP y de negocio del servicio de autenticación.",
  "tags": ["circleguard", "per-service"],
  "refresh": "30s",
  "schemaVersion": 38,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1, "title": "HTTP", "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2, "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=\"auth-service\"}[5m])) by (uri, method)", "legendFormat": "{{method}} {{uri}}", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3, "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=\"auth-service\",outcome=\"SERVER_ERROR\"}[5m]))", "legendFormat": "5xx/s", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4, "title": "Métricas de Negocio", "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5, "title": "Logins (por 5m)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(circleguard_logins_total{result=\"success\"}[5m])", "legendFormat": "Exitosos", "refId": "A" },
        { "expr": "rate(circleguard_logins_total{result=\"failure\"}[5m])", "legendFormat": "Fallidos", "refId": "B" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 10 },
      "id": 6, "title": "Logins exitosos (24h)",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["sum"] } },
      "targets": [{ "expr": "increase(circleguard_logins_total{result=\"success\"}[24h])", "legendFormat": "Logins OK", "refId": "A" }]
    }
  ]
}
